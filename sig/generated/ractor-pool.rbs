  #
  # @example
  #   pool << "http://example.com/page1"
  #   pool << "http://example.com/page2"
  #
  # @rbs (untyped work) -> void
  def <<: (untyped work) -> void

  # Shuts down the pool gracefully.
  #
  # This method:
  # 1. Prevents new work from being queued
